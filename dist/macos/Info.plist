<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for Zeren.app/Contents/Info.plist — see dist/README.md for the
     bundling steps. Replace __VERSION__ before packaging. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Zeren</string>
    <key>CFBundleExecutable</key>
    <string>zeren</string>
    <key>CFBundleIconFile</key>
    <string>zeren.icns</string>
    <key>CFBundleIconName</key>
    <string>Zeren</string>
    <key>CFBundleIdentifier</key>
    <string>sh.zeron.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Zeren</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <!-- The engine inside (Contents/MacOS/Zeren Engine). A running engine
         restarts into this bundle's when it's newer than itself; a beta app
         carries stable's engine, so its app version is no guide
         (crates/update bundle_engine_version). -->
    <key>ZerenEngineVersion</key>
    <string>__VERSION__</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>sh.zeron.app.conversation</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>zeren</string>
            </array>
        </dict>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Zeren uses your microphone for on-device dictation and for voice sessions you start. Voice sessions stream your audio to OpenAI through your ChatGPT-authenticated Codex account.</string>
    <!-- macOS 26 attaches one-time-code AutoFill (a SafariPlatformSupport
         helper process) to every text input unless the app opts out. -->
    <key>NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Browser tabs load user-selected HTTP dev servers. Keep the exception
         scoped to WebKit; other app connections retain their ATS policy. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
    </dict>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026</string>
    <!-- gpui renders via Metal. -->
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
